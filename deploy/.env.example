NZ_DB_NAME=nz_admin
NZ_DB_USERNAME=nz_admin
NZ_DB_PASSWORD=replace-with-a-long-random-password
NZ_POSTGRES_BIND=127.0.0.1
NZ_POSTGRES_PORT=5432

NZ_INITIALIZE_DATA=true
NZ_INITIAL_ADMIN_PASSWORD=replace-before-first-start
NZ_FILE_CONFIG_KEY=replace-with-at-least-32-random-characters
NZ_FIELD_ENCRYPTION_ENABLED=false
NZ_FIELD_ENCRYPTION_KEY=

NZ_WEB_PORT=80
NZ_BACKEND_BIND=127.0.0.1
NZ_BACKEND_PORT=8080

# 可选 Redis：启动时增加 --profile redis，并改为 true。
NZ_REDIS_ENABLED=false

# 可选 MinIO：启动时增加 --profile storage，并把文件存储类型改为 s3。
NZ_FILE_STORAGE_TYPE=local
NZ_MINIO_ROOT_USER=nzadmin
NZ_MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
NZ_S3_ENDPOINT=http://minio:9000
NZ_S3_BUCKET=nz-admin
NZ_MINIO_BIND=127.0.0.1
NZ_MINIO_API_PORT=9000
NZ_MINIO_CONSOLE_PORT=9001
